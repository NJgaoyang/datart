{
  "name": "datart",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "npm": ">=6.4.1",
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "bootstrap": "npm install --legacy-peer-deps",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:task": "node esbuild.task.mjs",
    "build:all": "npm run build:task && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --silent",
    "checkTs": "tsc --noEmit",
    "eslint": "eslint --ext js,ts,tsx",
    "lint": "npm run eslint src",
    "lint:fix": "npm run eslint --fix src",
    "lint:css": "npx stylelint \"src/**/*.css\"",
    "lint:style": "npx stylelint \"src/**/*.{js,ts,jsx,tsx}\"",
    "prettify": "prettier --write src",
    "prepare": "cd .. && husky install frontend/.husky",
    "doc:types": "tsc --project tsconfig.dHelper.json",
    "doc:html": "jsdoc -c jsdoc.config.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run eslint --fix",
      "npm run lint:style",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "coverageReporters": [
      "html",
      "lcov",
      "text-summary"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*/*.d.ts",
      "!src/**/*/Loadable.{js,jsx,ts,tsx}",
      "!src/**/*/messages.ts",
      "!src/**/*/types.ts",
      "!src/index.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.6",
    "@antv/g2": "^5.4.8",
    "@antv/s2": "^2.1.0",
    "@antv/s2-react": "^2.1.0",
    "@dinero.js/currencies": "^2.0.0-alpha.8",
    "@hello-pangea/dnd": "^16.6.0",
    "@reduxjs/toolkit": "^2.0.0",
    "antd": "^5.22.0",
    "axios": "^1.7.0",
    "classnames": "^2.3.1",
    "currency.js": "^2.0.4",
    "debounce-promise": "3.1.2",
    "echarts": "^5.5.0",
    "echarts-wordcloud": "^2.0.0",
    "events": "^3.3.0",
    "file-saver": "^2.0.5",
    "flexlayout-react": "^0.5.12",
    "i18next": "^23.0.0",
    "i18next-browser-languagedetector": "^7.0.0",
    "immer": "^10.0.0",
    "invariant": "^2.2.4",
    "js-cookie": "^2.2.1",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.45.0",
    "polished": "^4.1.1",
    "qs": "^6.10.3",
    "quill-image-drop-module": "1.0.3",
    "quilljs-markdown": "1.1.10",
    "react": "^18.2.0",
    "react-color": "2.19.3",
    "react-dev-inspector": "^1.6.0",
    "react-dnd": "^16.0.0",
    "react-dnd-html5-backend": "^16.0.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.3",
    "react-grid-layout": "^1.2.4",
    "react-helmet-async": "^2.0.0",
    "react-hotkeys-hook": "^3.4.0",
    "react-i18next": "^14.0.0",
    "react-monaco-editor": "^0.55.0",
    "react-quill-new": "^3.3.0",
    "react-redux": "^9.0.0",
    "react-resizable": "^1.11.1",
    "react-resize-detector": "^6.7.6",
    "react-router-dom": "^6.22.0",
    "react-window": "^1.8.6",
    "redux": "^5.0.1",
    "redux-undo": "^1.0.1",
    "reveal.js": "^4.1.0",
    "split.js": "^1.6.4",
    "sql-formatter": "9.2.0",
    "uuid": "^8.3.2",
    "video-react": "^0.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.15.8",
    "@babel/preset-env": "^7.15.8",
    "@commitlint/cli": "13.1.0",
    "@commitlint/config-conventional": "13.1.0",
    "@stylelint/postcss-css-in-js": "^0.38.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/js-cookie": "^2.2.6",
    "@types/lodash": "^4.14.172",
    "@types/node": "^18.0.0",
    "@types/react": "^18.2.79",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^18.2.25",
    "@types/react-grid-layout": "^1.1.1",
    "@types/react-resizable": "^1.7.4",
    "@types/react-test-renderer": "^18.0.0",
    "@types/styled-components": "^5.1.20",
    "@types/testing-library__jest-dom": "5.14.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^0.34.6",
    "ajv": "^8.20.0",
    "babel-plugin-styled-components": "^2.0.7",
    "cross-env": "7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "docdash": "^1.2.0",
    "esbuild": "^0.18.20",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "html2canvas": "^1.3.2",
    "husky": "^7.0.4",
    "jest-canvas-mock": "^2.3.1",
    "jest-styled-components": "^7.0.8",
    "jsdoc": "^3.6.10",
    "jsdom": "^22.1.0",
    "less": "^4.8.1",
    "lint-staged": "12.1.7",
    "postcss": "^8.4.6",
    "postcss-syntax": "^0.36.2",
    "prettier": "^2.2.1",
    "prettier-plugin-organize-imports": "^2.3.3",
    "react-test-renderer": "^18.2.0",
    "serve": "13.0.2",
    "source-map-explorer": "^2.5.2",
    "styled-components": "^6.1.0",
    "stylelint": "^14.9.1",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recess-order": "^3.0.0",
    "stylelint-config-recommended": "^8.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "typescript": "5.4.5",
    "vite": "^4.5.14",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^0.34.6"
  },
  "resolutions": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
